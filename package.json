{
  "name": "model-check-handson",
  "version": "1.0.0",
  "scripts": {
    "lint:text": "git ls-files '*.md' -z | xargs -0 -r textlint",
    "lint:markdown": "git ls-files '*.md' -z | xargs -0 -r markdownlint-cli2",
    "lint:mermaid": "node tools/check-mermaid.ts",
    "lint:ts": "tsc --noEmit",
    "lint": "pnpm run lint:text && pnpm run lint:markdown && pnpm run lint:mermaid && pnpm run lint:ts"
  },
  "license": "ISC",
  "devDependencies": {
    "@informalsystems/quint": "0.32.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "markdownlint-cli2": "^0.23.3",
    "mermaid": "^12.0.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-ja-space-around-code": "^3.0.3",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module"
}
